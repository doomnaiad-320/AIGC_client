{
  "name": "loomic",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "db:migrate": "node scripts/apply-postgres-migrations.mjs",
    "db:seed": "node scripts/seed-test-accounts.mjs",
    "admin:grant": "node scripts/grant-platform-admin.mjs",
    "admin:revoke": "node scripts/grant-platform-admin.mjs --revoke",
    "test:postgres-smoke": "node scripts/smoke-postgres-local.mjs",
    "test:billing-ledger": "node scripts/test-billing-ledger-local.mjs",
    "test:workspace": "node --test tests/workspace.test.mjs",
    "test:packages": "turbo run test",
    "test": "pnpm run test:workspace && pnpm run test:packages",
    "seed": "pnpm db:seed",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "global-agent": "^4.1.3",
    "pg": "^8.20.0"
  }
}
