# PostgreSQL and application auth
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/loomic
POSTGRES_POOL_MAX=10
APP_JWT_SECRET=replace-with-a-long-random-secret
LOOMIC_STORAGE_ROOT=.loomic-storage
LOOMIC_SERVER_PUBLIC_URL=http://127.0.0.1:3001
LOOMIC_WEB_ORIGIN=http://127.0.0.1:3000

# AI
OPENAI_API_KEY=your-openai-api-key
# OPENAI_API_BASE=https://api.openai.com/v1  # optional, for custom endpoints

# Image Generation
# REPLICATE_API_TOKEN=your-replicate-token  # optional, enables image generation

# Google Fonts (required for brand kit font picker)
GOOGLE_FONTS_API_KEY=your-google-fonts-api-key

# TTS (optional)
# VOLCES_API_KEY=your-volces-key
# VOLCES_BASE_URL=https://...

# Worker (optional)
# WORKER_POLL_INTERVAL_MS=2000
# WORKER_MAX_BATCH_SIZE=5
